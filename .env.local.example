# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LiveKit Cloud project settings -> Keys
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# A secret only you know. Visiting /room?key=<this value> once grants
# broadcaster permissions (screen share) and is remembered from then on.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
BROADCASTER_KEY=
